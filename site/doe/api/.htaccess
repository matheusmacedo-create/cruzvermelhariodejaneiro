# Backend das doações (/doe/). Só os endpoints públicos respondem por HTTP; configuração,
# bootstrap e módulos são incluídos pelo PHP e nunca servidos.
Options -Indexes
<FilesMatch "^(config\.php|config\.example\.php|lib\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
</IfModule>
